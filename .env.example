# =============================================================================
# DealTrack 配置示例
#
# 复制为 .env 后按需修改。全部可选 —— 不配任何一项也能完整运行：
# 未配置的集成会进入「模拟发送」模式，流程照常推进，只是不真正投递。
# =============================================================================

# ---- 服务 -------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
DEALTRACK_PUBLIC_URL=http://localhost:8787

# 安卓 App 与外部脚本用它访问。对外部署请务必改成随机长串：
#   openssl rand -base64 24
DEALTRACK_API_TOKEN=dealtrack-dev-token

# 数据目录（数据库、导出文档、加密主密钥都在这里）
# DEALTRACK_DATA_DIR=./data
# DEALTRACK_DB_FILE=./data/dealtrack.sqlite

# 主密钥；不设则自动生成到 data/.master.key（权限 600，已 gitignore）
# DEALTRACK_MASTER_KEY=

# ---- 核心指标 ---------------------------------------------------------------
# 这两个数字定义了产品存在的意义：把 30 分钟压到 3 分钟
DEALTRACK_BASELINE_MINUTES=30
DEALTRACK_TARGET_MINUTES=3

# ---- LLM（BYOK，也可在「设置 → AI 模型」里填，界面优先）----------------------
# mock | openai | deepseek | ollama | openai-compatible
DEALTRACK_LLM_PROVIDER=mock
DEALTRACK_LLM_MODEL=
DEALTRACK_LLM_BASE_URL=
DEALTRACK_LLM_TEMPERATURE=0.3
DEALTRACK_LLM_MAX_TOKENS=2048

OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# 本地 Ollama 示例（数据完全不出本机）：
# DEALTRACK_LLM_PROVIDER=ollama
# DEALTRACK_LLM_MODEL=qwen2.5:7b
# DEALTRACK_LLM_BASE_URL=http://localhost:11434

# ---- 邮件集成（留空 / 0 = 模拟发送）------------------------------------------
DEALTRACK_EMAIL_ENABLED=0
DEALTRACK_IMAP_HOST=
DEALTRACK_IMAP_PORT=993
DEALTRACK_IMAP_SECURE=1
DEALTRACK_IMAP_MAILBOX=INBOX
DEALTRACK_SMTP_HOST=
DEALTRACK_SMTP_PORT=465
DEALTRACK_SMTP_SECURE=1
DEALTRACK_EMAIL_USER=
DEALTRACK_EMAIL_PASSWORD=
DEALTRACK_EMAIL_FROM_NAME=DealTrack Sales
DEALTRACK_IMAP_POLL_SECONDS=60

# ---- WhatsApp Business API（留空 / 0 = 模拟发送）-----------------------------
DEALTRACK_WHATSAPP_ENABLED=0
DEALTRACK_WHATSAPP_PHONE_NUMBER_ID=
DEALTRACK_WHATSAPP_ACCESS_TOKEN=
DEALTRACK_WHATSAPP_VERIFY_TOKEN=
DEALTRACK_WHATSAPP_API_VERSION=v21.0

# ---- OCR（附件识别，留空 = 保留附件并提示人工阅读）---------------------------
DEALTRACK_OCR_ENABLED=0
DEALTRACK_OCR_PROVIDER=textin
DEALTRACK_OCR_API_KEY=
DEALTRACK_OCR_ENDPOINT=https://api.textin.com/ai/service/v1/pdf_to_markdown

# ---- 文档渲染 ---------------------------------------------------------------
# 留空则自动探测常见安装路径。没有 Chrome 时仍会输出可直接打印的 HTML。
# DEALTRACK_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# DEALTRACK_PDF_TIMEOUT_MS=30000

# ---- 工作池 -----------------------------------------------------------------
DEALTRACK_WORKERS=1
DEALTRACK_WORKER_CONCURRENCY=4
DEALTRACK_WORKER_POLL_MS=750
DEALTRACK_MAX_ATTEMPTS=3
