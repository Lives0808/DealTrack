{
  "name": "@dealtrack/server",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "DealTrack server — multi-agent orchestrator, pricing engine, integrations and REST/SSE API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed-cli.ts",
    "smoke": "tsx src/scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "@types/mailparser": "^3.9.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "imapflow": "^1.0.171",
    "mailparser": "^3.9.31",
    "nodemailer": "^6.9.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
