# Android 发布签名配置示例
#
# 复制为 android/keystore.properties 并填入自己的密钥。
# 这个文件与它引用的 keystore 文件都已被 .gitignore 排除，不会进仓库。
#
# 生成一个发布密钥：
#
#   keytool -genkeypair -v \
#     -keystore ~/dealtrack-release.jks \
#     -alias dealtrack \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -storetype JKS
#
# 不配置这个文件时，`./gradlew assembleRelease` 会退回使用 Android 调试签名 ——
# 依然能产出可安装的 APK（CI 与 GitHub Release 就是这么做的），只是不适合正式分发。

storeFile=/absolute/path/to/dealtrack-release.jks
storePassword=your-store-password
keyAlias=dealtrack
keyPassword=your-key-password
