<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- The API token is device-local; never sync it to another device. -->
        <exclude domain="sharedpref" path="dealtrack.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="dealtrack.xml" />
    </device-transfer>
</data-extraction-rules>
